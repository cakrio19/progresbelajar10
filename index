<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Papan Progres & Komitmen Belajar</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .loader { border-top-color: #2563eb; animation: spinner 1s linear infinite; }
    @keyframes spinner { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans">

  <!-- Navbar -->
  <nav class="bg-blue-700 text-white shadow-md sticky top-0 z-40">
    <div class="max-w-6xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center gap-2">
      <div>
        <h1 class="font-bold text-lg tracking-tight">📚 Papan Akuntabilitas Belajar</h1>
        <p class="text-xs text-blue-200">Progres Mapel Favorit & Mapel Berjuang</p>
      </div>
      
      <div class="flex flex-wrap items-center gap-2">
        <!-- Menu saat belum ada yang login (Guest) -->
        <div id="guestNav" class="flex gap-2">
          <button onclick="openLoginModal()" class="bg-white text-blue-700 hover:bg-blue-50 text-sm font-semibold px-3.5 py-2 rounded-lg shadow transition">
            🔑 Login Siswa
          </button>
          <button onclick="openAdminModal()" class="bg-blue-900 hover:bg-slate-900 text-blue-100 text-sm font-semibold px-3.5 py-2 rounded-lg transition">
            👨‍🏫 Login Guru
          </button>
        </div>

        <!-- Menu saat Siswa Login -->
        <div id="studentNav" class="hidden flex items-center gap-2">
          <span class="text-xs bg-blue-800 px-3 py-1.5 rounded-lg border border-blue-600">
            🎓 <b id="navStudentName"></b>
          </span>
          <button onclick="openUploadModal()" class="bg-emerald-500 hover:bg-emerald-600 text-white text-sm font-semibold px-3 py-2 rounded-lg shadow transition">
            + Setor Progres
          </button>
          <button onclick="logoutUser()" class="bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold px-2.5 py-2 rounded-lg transition">
            Logout
          </button>
        </div>

        <!-- Menu saat Guru Login -->
        <div id="adminNav" class="hidden flex items-center gap-2">
          <span class="text-xs bg-amber-500 text-slate-900 font-bold px-3 py-1.5 rounded-lg shadow-sm">
            👨‍🏫 Mode Guru Aktif
          </span>
          <button onclick="openAdminModal()" class="bg-blue-800 hover:bg-blue-900 text-white text-xs font-semibold px-3 py-2 rounded-lg border border-blue-600 transition">
